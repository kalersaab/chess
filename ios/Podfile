# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'chess' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  shared_dir = "#{Pod::Config.instance.installation_root}/../shared"
  ios_src_dir = "#{Pod::Config.instance.installation_root}/../ios/chess"

  # All C++ engine files from shared/ plus the iOS-specific provider file
  chess_sources = Dir.glob("#{shared_dir}/**/*.{cpp,mm}") +
                  Dir.glob("#{ios_src_dir}/NativeChessModuleProvider.mm")

  chess_headers = [
    "#{shared_dir}",
    "#{shared_dir}/chess",
    "#{Pod::Config.instance.installation_root}/build/generated/ios/ReactCodegen",
  ]

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.aggregate_targets.each do |agg|
      agg.user_project.targets.each do |t|
        next unless t.name == 'chess'

          t.build_configurations.each do |bc|
          inherited_paths = ['$(inherited)'] + chess_headers.map { |p| "\"#{p}\"" }
          bc.build_settings['HEADER_SEARCH_PATHS'] = inherited_paths.join(' ')
          bc.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = '$(inherited)'
          bc.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
          bc.build_settings['GCC_ENABLE_CPP_EXCEPTIONS'] = 'YES'
          # Append AVFoundation while preserving xcconfig-inherited flags
          bc.build_settings['OTHER_LDFLAGS'] = '$(inherited) -framework AVFoundation'
        end

        # Source files — add each .cpp/.mm as a PBXBuildFile if not already present
        sources_phase = t.source_build_phase
        chess_sources.each do |src_path|
          next if sources_phase.files.any? { |f| f.file_ref&.path == src_path }
          file_ref = t.project.new_file(src_path)
          sources_phase.add_file_reference(file_ref, true)
        end

        # Copy MP3 sound assets into the app bundle (Resources)
        sound_dir = "#{Pod::Config.instance.installation_root}/../assets/sounds"
        mp3_files = Dir.glob("#{sound_dir}/*.mp3")

        # Find or create a "Copy Files" resources phase
        resources_phase = t.resources_build_phase
        mp3_files.each do |mp3_path|
          next if resources_phase.files.any? { |f| f.file_ref&.path == mp3_path }
          file_ref = t.project.new_file(mp3_path)
          resources_phase.add_file_reference(file_ref, true)
        end

        t.project.save
      end
    end
  end
end
